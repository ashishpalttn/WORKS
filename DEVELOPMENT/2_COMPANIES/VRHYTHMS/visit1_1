export const selectBed = (state) => state.patientDetails.bed;
export const selectPatientDetailsLoading = (state) => state.patientDetails.loading;
export const selectPatientDetailsError = (state) => state.patientDetails.error;
export const selectNotes = (state) => state.patientDetails.notes;
export const selectTodos = (state) => state.patientDetails.todos;
export const selectBarriers = (state) => state.patientDetails.barriers;

export const { deleteTodo } = patientDetailsSlice.actions;

export default patientDetailsSlice.reducer;